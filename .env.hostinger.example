APP_NAME="Fondation TUBAWWIRI (TBW)"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tubawwiri.org

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Remplir avec MySQL Hostinger (hPanel → Bases de données)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# SMTP Hostinger (ou emails pro @tubawwiri.org)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=contact@tubawwiri.org
MAIL_FROM_NAME="Fondation TUBAWWIRI (TBW)"

VITE_APP_NAME="${APP_NAME}"

MAIL_TO_CONTACT=contact@tubawwiri.org
MAIL_TO_PARTNERSHIP=partenariat@tubawwiri.org
MAIL_TO_ACADEMY=academy@tubawwiri.org
MAIL_TO_CONSULTING=consulting@tubawwiri.org
MAIL_TO_DONATIONS=contact@tubawwiri.org
MAIL_TO_JOIN=contact@tubawwiri.org
MAIL_TO_NEWSLETTER=contact@tubawwiri.org

